# 운영 서버 환경변수. 복사해서 .env.prod로 만들고 값을 채운다. .env.prod는 커밋하지 않는다.
# 서비스 도메인 (DNS A 레코드가 이 서버를 가리켜야 HTTPS 인증서가 발급된다)
DOMAIN=
DB_ROOT_PASSWORD=
DB_USERNAME=ilililissue
DB_PASSWORD=
# 32바이트 이상 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
# 뉴스 자동 초안(선택). true면 매일 07:00 실행
NEWS_DRAFT_ENABLED=false
OPENAI_API_KEY=
